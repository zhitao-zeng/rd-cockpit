# All values are optional. Copy only the settings you need into your shell or
# a local secret manager; never commit real credentials.
RD_COCKPIT_HOME=/absolute/path/to/rd-cockpit
RD_DAILY_REPORT_DIR=~/daily-reports
RD_WORKSPACE_ROOTS=~/code

# Optional LLM integrations. Deterministic views need no API key.
# RD_LLM_BASE_URL=http://127.0.0.1:4000/v1
# RD_LLM_API_KEY=
# RD_LLM_MODEL=
# RD_LLM_FALLBACK_MODEL=
