# All values are optional. Copy only the settings you need into your shell or
# a local secret manager; never commit real credentials.
RD_COCKPIT_HOME=/absolute/path/to/rd-cockpit
RD_VIEW_CACHE_RETENTION_DAYS=14
RD_VIEW_CACHE_MAX_MB=100
RD_DAILY_REPORT_DIR=~/daily-reports
RD_WORKSPACE_ROOTS=~/code
# RD_CODEX_BIN=/absolute/path/to/codex
# RD_CLAUDE_BIN=/absolute/path/to/claude
# RD_WEB_HOST=127.0.0.1
# Required automatically for non-loopback installs. The browser asks for it
# once and stores it in localStorage; never commit the value.
# RD_API_TOKEN=
# Expose old raw event/timeline routes in the production web process. Off by default.
# RD_ENABLE_LEGACY_API=0
# Production serves the page and API together on port 4016. Set this to 1 only
# when a separate development/compatibility API on port 8787 is also needed.
# RD_ENABLE_STANDALONE_API=0
# RD_MODEL_ROUTER_URL=http://127.0.0.1:4000/v1/messages
# RD_MODEL_ROUTER_API_KEY=
# Maximum architecture model attempts per nightly refresh. Unchanged projects
# use zero calls; overflow remains queued for the next night.
# RD_ALGORITHM_MAX_MODEL_CALLS=4
# A live Agent session is written to history only after this quiet period.
# RD_USAGE_QUIET_MINUTES=30

# Optional LLM integrations. Deterministic views need no API key.
# RD_LLM_BASE_URL=http://127.0.0.1:4000/v1
# RD_LLM_API_KEY=
# RD_LLM_MODEL=
# RD_LLM_FALLBACK_MODEL=
